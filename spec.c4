specification {
  element actor {
    style { shape person; color gray }
  }
  element application {
    style { color primary }
  }
  element service {
    style { color indigo }
  }
  element component {
    style { color secondary }
  }
  element api{
    style {
      color sky
      shape mobile
    }
  }
  element messageBroker {
    style { color amber }
  }
  element queue {
    style { shape queue }
  }
  element database {
    style { 
      color green 
      shape storage
    }
  }
}

model {
  scannerNetwork = actor 'Parcel scanner network' {
    description 'Publishes neutral parcel scan events for processing'
  }

  kafka = messageBroker 'Kafka' {
    technology 'Apache Kafka'

    inputTopic = queue 'Parcel events' {
      description 'Receives parcel scan events that need to be processed'
      style { color green }
    }

    outputTopic = queue 'Normalized parcel events' {
      description 'Receives normalized events published by the ingestion service'
      style { color gray }
    }
  }

  parcelPlatform = application 'Parcel event platform' {
    description 'Processes parcel events and exposes their latest state'

    ingestionService = service 'Ingestion service' {
      description 'Consumes parcel events, validates and persists them, and publishes normalized events'

      consumer = component 'Kafka consumer' {
        description 'Receives parcel events from the input topic'
      }

      validator = component 'Event validator' {
        description 'Validates and normalizes parcel events'
      }

      persister = component 'Event persister' {
        description 'Stores valid parcel events'
      }

      publisher = component 'Event publisher' {
        description 'Publishes normalized parcel events'
      }
    }

    queryApi = api 'Parcel query API' {
      description 'Exposes endpoints for reading the latest parcel state'
      technology 'REST API'
    }

    dataStore = database 'Parcel event database' {
      description 'Stores parcel events processed by the ingestion service'
      technology 'PostgreSQL'
    }
  }

  downstreamService = service 'Downstream service' {
    description 'Processes normalized parcel events published by the platform'

    consumer = component 'Output topic consumer' {
      description 'Consumes and processes normalized parcel events'
    }
  }

  scannerNetwork -> kafka.inputTopic 'Publishes parcel events'
  kafka.inputTopic -> parcelPlatform.ingestionService.consumer 'Delivers parcel events'
  parcelPlatform.ingestionService.consumer -> parcelPlatform.ingestionService.validator 'Forwards received event'
  parcelPlatform.ingestionService.validator -> parcelPlatform.ingestionService.persister 'Sends valid event'
  parcelPlatform.ingestionService.persister -> parcelPlatform.dataStore 'Persists event'
  parcelPlatform.ingestionService.validator -> parcelPlatform.ingestionService.publisher 'Sends normalized event'
  parcelPlatform.ingestionService.publisher -> kafka.outputTopic 'Publishes normalized event'
  parcelPlatform.queryApi -> parcelPlatform.dataStore 'Reads parcel state'
  kafka.outputTopic -> downstreamService.consumer 'Delivers normalized event'
}

views {
  view index {
    title 'Parcel event processing landscape'
    include scannerNetwork
    include kafka with {
      navigateTo kafka-details
    }
    include parcelPlatform with {
      navigateTo parcel-application
    }
    autoLayout LeftRight
  }

  view parcel-application of parcelPlatform {
    title 'Parcel event platform'
    include *
    include kafka with {
      navigateTo kafka-details
    }
    include parcelPlatform.ingestionService with {
      navigateTo ingestion-service
    }
    autoLayout LeftRight
  }

  view ingestion-service of parcelPlatform.ingestionService {
    title 'Ingestion service internals'
    include *
    include kafka.inputTopic
    include kafka.outputTopic
    include parcelPlatform.dataStore
    include parcelPlatform.ingestionService.consumer with {
      navigateTo consumer-data-flow
    }
    autoLayout LeftRight
  }

  dynamic view consumer-data-flow {
    title 'Parcel event consumer data flow'
    variant sequence

    kafka.inputTopic -> parcelPlatform.ingestionService.consumer 'Delivers parcel event'
    parcelPlatform.ingestionService.consumer -> parcelPlatform.ingestionService.validator 'Forwards received event'
    parcelPlatform.ingestionService.validator -> parcelPlatform.ingestionService.persister 'Sends valid event'
    parcelPlatform.ingestionService.persister -> parcelPlatform.dataStore 'Persists event'
    parcelPlatform.ingestionService.persister <- parcelPlatform.dataStore 'Confirms persistence'
    parcelPlatform.ingestionService.validator -> parcelPlatform.ingestionService.publisher 'Sends normalized event'
    parcelPlatform.ingestionService.publisher -> kafka.outputTopic 'Publishes normalized event'
  }

  view kafka-details of kafka {
    title 'Kafka topics and consumers'
    include *
    include parcelPlatform
    include downstreamService with {
      navigateTo downstream-service
    }
    autoLayout LeftRight
  }

  view downstream-service of downstreamService {
    title 'Downstream service internals'
    include *
    include kafka.outputTopic
    autoLayout LeftRight
  }
}
